# Copy to a deployment-only environment file. Never commit the populated file.
NEXUSQ_VAULT_PATH=/var/lib/nexusq/vault.nqx
NEXUSQ_SERVER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
NEXUSQ_SERVER_ADDR=127.0.0.1:8443
NEXUSQ_SERVER_RATE_LIMIT=60
NEXUSQ_SERVER_MAX_BODY_BYTES=1048576
# Set to 1 only when a trusted TLS/mTLS proxy terminates transport security.
NEXUSQ_TRUSTED_TLS_TERMINATION=0
RUST_LOG=nexusq_server=info
