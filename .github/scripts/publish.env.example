# Copy to ~/.config/nexusq/publish.env, fill locally, chmod 600.
# Never commit the filled file or send these values in chat.
CRATES_IO_TOKEN=
PYPI_TOKEN=
NPM_TOKEN=
RUBYGEMS_API_KEY=
PACKAGIST_USERNAME=
PACKAGIST_API_TOKEN=
# Dart uses the existing dart pub token login.
# Maven Central: configure ~/.m2/settings.xml with server id "central"
# and your Sonatype Central Portal user-token username/password pair.
# Maven artifacts must be signed with a GPG private key imported locally.
