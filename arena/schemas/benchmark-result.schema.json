{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXUS-Q PQC Benchmark Result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "implementation",
    "algorithm",
    "operation",
    "environment",
    "measurement"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "algorithm": {
      "type": "object",
      "required": [
        "id",
        "parameter_set"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "parameter_set": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "enum": [
        "keygen",
        "encaps",
        "decaps",
        "sign",
        "verify",
        "workflow",
        "tls-handshake",
        "api-request",
        "vault-operation"
      ]
    },
    "environment": {
      "type": "object",
      "required": [
        "target",
        "os",
        "cpu",
        "compiler"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "cpu_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compiler": {
          "type": "string"
        },
        "compiler_version": {
          "type": "string"
        },
        "optimization": {
          "type": "string"
        },
        "harness_version": {
          "type": "string"
        },
        "rustc_verbose": {
          "type": "string"
        },
        "cargo_lock_sha256": {
          "type": "string"
        },
        "cpu_frequency_khz": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cpu_governor": {
          "type": "string"
        },
        "run_order": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": [
        "iterations",
        "warmups",
        "latency_ns",
        "measurement_timestamp_unix_ns"
      ],
      "properties": {
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "warmups": {
          "type": "integer",
          "minimum": 0
        },
        "measurement_timestamp_unix_ns": {
          "type": "integer",
          "minimum": 1
        },
        "latency_ns": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "throughput_ops_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "measurement_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "samples_ns": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "statistics": {
          "$ref": "#/$defs/sampleStatistics"
        },
        "seed_count": {
          "type": "integer",
          "minimum": 1
        },
        "samples_per_seed": {
          "type": "integer",
          "minimum": 1
        },
        "seed_samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/seedSample"
          }
        }
      },
      "additionalProperties": false
    },
    "sizes": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "public_key_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "secret_key_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ciphertext_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "signature_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sampleStatistics": {
      "type": "object",
      "required": [
        "sample_count",
        "min_ns",
        "median_ns",
        "p95_ns",
        "stddev_ns"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "min_ns": {
          "type": "integer",
          "minimum": 1
        },
        "median_ns": {
          "type": "integer",
          "minimum": 1
        },
        "p95_ns": {
          "type": "integer",
          "minimum": 1
        },
        "stddev_ns": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "seedSample": {
      "type": "object",
      "required": [
        "seed_id",
        "samples_ns",
        "summary"
      ],
      "properties": {
        "seed_id": {
          "type": "string",
          "minLength": 1
        },
        "samples_ns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "summary": {
          "$ref": "#/$defs/sampleStatistics"
        }
      },
      "additionalProperties": false
    }
  }
}
